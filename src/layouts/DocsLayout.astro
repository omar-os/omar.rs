---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description, lang = "en" } = Astro.props;
const isZh = lang.startsWith("zh");
const base = import.meta.env.BASE_URL;

const sidebarItems = isZh
  ? [{ href: `${base}zh/docs/`, label: "快速开始" }]
  : [{ href: `${base}docs/`, label: "Getting Started" }];

const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="docs-layout container">
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <p class="sidebar-title">{isZh ? "文档" : "Documentation"}</p>
        {
          sidebarItems.map((item) => (
            <a
              href={item.href}
              class:list={["sidebar-link", { active: pathname === item.href }]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </aside>
    <article class="docs-content prose">
      <h1>{title}</h1>
      <slot />
    </article>
  </div>

  <script>
    // Wrap bare tables in a scrollable container for mobile
    document.querySelectorAll(".docs-content table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-wrapper")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "table-wrapper";
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  </script>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    min-height: calc(100vh - 3.5rem);
  }

  .sidebar {
    position: sticky;
    top: 5rem;
    height: fit-content;
  }

  .sidebar-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    font-weight: 500;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
  }

  .sidebar-link {
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    border-radius: 4px;
    transition: all 0.1s;
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .sidebar-link:hover {
    color: var(--text-bright);
  }

  .sidebar-link.active {
    color: var(--text-bright);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
    }

    .sidebar {
      position: static;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.25rem;
      min-width: max-content;
    }

    .sidebar-title {
      display: none;
    }

    .sidebar-link {
      border-left: none;
      font-size: 0.8rem;
      padding: 0.35rem 0.65rem;
      white-space: nowrap;
      border-radius: 999px;
      background: var(--bg-surface);
    }

    .sidebar-link.active {
      background: var(--accent);
      color: var(--accent-contrast);
      border-left-color: transparent;
    }

    .docs-content {
      min-width: 0;
      overflow-x: hidden;
    }
  }
</style>
