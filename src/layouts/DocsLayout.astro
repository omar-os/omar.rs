---
import BaseLayout from "./BaseLayout.astro";

import type { DevMeta } from "../lib/devdocs";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /** Set on a developer docs page: its version and that version's pages. */
  dev?: {
    version: string;
    meta?: DevMeta;
    choices: { name: string; href: string }[];
    pages: { href: string; label: string; current: boolean }[];
  };
}

const { title, description, lang = "en", dev } = Astro.props;
const isZh = lang.startsWith("zh");
const base = import.meta.env.BASE_URL;

const sidebarItems = isZh
  ? [{ href: `${base}zh/docs/`, label: "快速开始" }]
  : [
      { href: `${base}docs/`, label: "Getting Started" },
      { href: `${base}docs/messaging/`, label: "Messaging" },
    ];
const devRoot = `${base}docs/dev/`;
const commitUrl = (sha: string) =>
  `https://github.com/omar-os/omar/commit/${sha}`;

const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description} lang={lang}>
  <div class="docs-layout container">
    <aside class="sidebar">
      <nav class="sidebar-nav">
        <p class="sidebar-title">{isZh ? "文档" : "Documentation"}</p>
        {
          sidebarItems.map((item) => (
            <a
              href={item.href}
              class:list={["sidebar-link", { active: pathname === item.href }]}
            >
              {item.label}
            </a>
          ))
        }
        {
          !isZh && (
            <>
              <p class="sidebar-title sidebar-group">Developer</p>
              {dev ? (
                <>
                  <label class="version-picker">
                    <span>Version</span>
                    <select
                      data-version-picker
                      aria-label="Developer docs version"
                    >
                      {dev.choices.map((choice) => (
                        <option
                          value={choice.href}
                          selected={choice.name === dev.version}
                        >
                          {choice.name}
                        </option>
                      ))}
                    </select>
                  </label>
                  {dev.pages.map((item) => (
                    <a
                      href={item.href}
                      class:list={["sidebar-link", { active: item.current }]}
                      aria-current={item.current ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  ))}
                </>
              ) : (
                <a href={devRoot} class="sidebar-link">
                  How OMAR works
                </a>
              )}
            </>
          )
        }
      </nav>
    </aside>
    <article class="docs-content prose">
      {
        dev?.meta && (
          <p class="dev-version">
            {dev.version === "main" ? (
              <>
                Developer docs for <strong>main</strong>, checked against{" "}
                <a href={commitUrl(dev.meta.commit)}>
                  <code>{dev.meta.commit.slice(0, 7)}</code>
                </a>{" "}
                on {dev.meta.synced}.
              </>
            ) : (
              <>
                Developer docs frozen at release <strong>{dev.version}</strong>,
                commit{" "}
                <a href={commitUrl(dev.meta.commit)}>
                  <code>{dev.meta.commit.slice(0, 7)}</code>
                </a>
                · <a href={dev.choices[0].href}>See main</a>
              </>
            )}
          </p>
        )
      }
      <h1>{title}</h1>
      <slot />
    </article>
  </div>

  <script>
    // The version picker's options are the same page in each version.
    document
      .querySelectorAll<HTMLSelectElement>("[data-version-picker]")
      .forEach((select) =>
        select.addEventListener("change", () => {
          window.location.href = select.value;
        }),
      );

    // On a phone the sidebar is one scrolling row; show the current page.
    document
      .querySelector(".sidebar .sidebar-link.active")
      ?.scrollIntoView({ block: "nearest", inline: "center" });

    // Wrap bare tables in a scrollable container for mobile
    document.querySelectorAll(".docs-content table").forEach((table) => {
      if (table.parentElement?.classList.contains("table-wrapper")) return;
      const wrapper = document.createElement("div");
      wrapper.className = "table-wrapper";
      table.parentNode?.insertBefore(wrapper, table);
      wrapper.appendChild(table);
    });
  </script>
</BaseLayout>

<style>
  .docs-layout {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: 3.5rem;
    padding-bottom: 4rem;
    min-height: calc(100vh - 3.5rem);
  }

  .sidebar {
    position: sticky;
    top: 5rem;
    height: fit-content;
  }

  .sidebar-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    font-weight: 500;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
  }

  .sidebar-group {
    margin-top: 1.5rem;
  }

  .version-picker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem 0.6rem;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .version-picker select {
    flex: 1;
    min-width: 0;
    font: inherit;
    color: var(--text-bright);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.45rem;
  }

  .version-picker select:hover,
  .version-picker select:focus-visible {
    border-color: var(--border-hover);
  }

  .dev-version {
    font-size: 0.85rem;
    color: var(--text-dim);
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .sidebar-link {
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    border-radius: 4px;
    transition: all 0.1s;
    text-decoration: none;
    border-left: 2px solid transparent;
  }

  .sidebar-link:hover {
    color: var(--text-bright);
  }

  .sidebar-link.active {
    color: var(--text-bright);
    background: var(--accent-soft);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .docs-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-top: 1.5rem;
      padding-bottom: 2.5rem;
    }

    .sidebar {
      position: static;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.75rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .sidebar-nav {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0.25rem;
      min-width: max-content;
    }

    .sidebar-title {
      display: none;
    }

    .version-picker {
      padding: 0 0.25rem 0 0;
      flex: none;
    }

    .version-picker span {
      display: none;
    }

    .sidebar-link {
      border-left: none;
      font-size: 0.8rem;
      padding: 0.35rem 0.65rem;
      white-space: nowrap;
      border-radius: 999px;
      background: var(--bg-surface);
    }

    .sidebar-link.active {
      background: var(--accent);
      color: var(--accent-contrast);
      border-left-color: transparent;
    }

    .docs-content {
      min-width: 0;
      overflow-x: hidden;
    }
  }
</style>
