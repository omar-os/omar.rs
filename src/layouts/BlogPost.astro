---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  date: string;
  description?: string;
  author?: string;
  lang?: string;
}

const {
  title,
  date,
  description,
  author = "OMAR Team",
  lang = "en",
} = Astro.props;
const isZh = lang.startsWith("zh");
const dateLocale = isZh ? "zh-CN" : "en-US";
const base = import.meta.env.BASE_URL;
const blogHref = isZh ? `${base}zh/blog/` : `${base}blog/`;
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="blog-post container">
    <header class="post-header">
      <a href={blogHref} class="post-back"
        >&larr; {isZh ? "所有文章" : "All posts"}</a
      >
      <time class="post-date"
        >{
          new Date(date).toLocaleDateString(dateLocale, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }</time
      >
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc">{description}</p>}
      <span class="post-author"
        >{isZh ? `作者：${author}` : `by ${author}`}</span
      >
    </header>
    <div class="post-body prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: 42rem;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .post-back {
    font-size: 0.85rem;
    color: var(--text-dim);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .post-back:hover {
    color: var(--text-bright);
  }

  .post-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    font-size: 0.825rem;
    color: var(--text-dim);
  }

  .post-title {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0.5rem 0;
    color: var(--text-bright);
  }

  .post-desc {
    font-size: 1.05rem;
    color: var(--text-dim);
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .post-author {
    font-size: 0.825rem;
    color: var(--text-dim);
  }
</style>
