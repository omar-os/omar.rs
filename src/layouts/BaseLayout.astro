---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  description = "Deterministic orchestration for agentic systems",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050507" />
    <meta name="color-scheme" content="dark" />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}omar-favicon.png`}
    />
    <title>{title} | OMAR</title>
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
