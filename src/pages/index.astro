---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentMachineHero from "../components/AgentMachineHero.astro";
---

<BaseLayout
  title="Home"
  description="Deploy deterministic, verifiable, programmable agentic workflows."
>
  <AgentMachineHero lang="en" />

  <!-- Features -->
  <section class="features">
    <div class="container">
      <h2 class="section-title">Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>📜 Explicit coordination contracts</h3>
          <p>
            Declare typed inputs and outputs, triggers, and permitted output
            writes. OMAR provides system-level determinism for scheduling and
            handoffs, with compiler validation and runtime enforcement of output
            contracts.
          </p>
        </div>
        <div class="feature-card">
          <h3>🤝 Mixed agent teams</h3>
          <p>
            Put Claude Code, Codex, Cursor, OpenCode, Antigravity, and Pi in the
            same workflow. Choose a backend for each role using the <a
              href="/docs/">supported agent backends</a
            >.
          </p>
        </div>
        <div class="feature-card">
          <h3>🪆 Teams within teams</h3>
          <p>
            Compose reusable, parameterized teams into deeper hierarchies. Build
            pipelines, parallel branches, and feedback loops with explicit
            connections between them.
          </p>
        </div>
        <div class="feature-card">
          <h3>🔎 Live visibility and direct access</h3>
          <p>
            Follow execution status and values in Mission Control's live
            diagram. Open an individual agent's terminal to inspect its session
            and interact directly.
          </p>
        </div>
        <div class="feature-card">
          <h3>🧠 Model heterogeneity</h3>
          <p>
            Combine fast System I models such as Jev with System II reasoning
            models in the same workflow.
          </p>
        </div>
        <div class="feature-card">
          <h3>⏯️ Checkpointed workflows</h3>
          <p>
            Pause and resume workflows at well-defined checkpoints between
            logical tags.
          </p>
        </div>
        <div class="feature-card">
          <h3>🛠️ Flexible sessions and familiar tools</h3>
          <p>
            Run long-lived or task-specific agents, with terminal access and the <code
              >tmux</code
            > controls you already use.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Demo -->
  <section class="demo">
    <div class="container">
      <figure class="demo-figure">
        {
          /* Silent screen capture, so it may autoplay muted and loop the way
             the terminal cast beside it does. `playsinline` keeps iOS from
             taking it fullscreen; controls are there because it runs for three
             minutes and nobody should have to watch it from the top. */
        }
        <video
          src={`${import.meta.env.BASE_URL}video/hierarchy.mp4`}
          poster={`${import.meta.env.BASE_URL}video/hierarchy-poster.jpg`}
          width="1280"
          height="694"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"></video>
        <figcaption>Mission Control</figcaption>
      </figure>
      <figure class="demo-figure">
        <iframe
          title="Terminal UI demo"
          src="https://asciinema.org/a/946195/iframe?autoplay=1&loop=1&speed=2&theme=asciinema"
          allowfullscreen
          loading="lazy"
          scrolling="no"></iframe>
        <figcaption>Terminal UI</figcaption>
      </figure>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="quickstart">
    <div class="container">
      <h2 class="section-title">Quick Start</h2>
      <div class="install-methods">
        <div class="install-tabs">
          <button class="install-tab active" data-tab="oneliner"
            >One-Liner</button
          >
          <button class="install-tab" data-tab="brew">Homebrew</button>
          <button class="install-tab" data-tab="source">From Source</button>
        </div>
        <div class="install-panel active" id="panel-oneliner">
          <pre><code><span class="prompt">$</span> curl -fsSL https://omar.rs/install.sh | sh</code></pre>
          <p class="install-note">
            Works on macOS and Linux. Installs all binaries to <code
              >/usr/local/bin</code
            >.
          </p>
        </div>
        <div class="install-panel" id="panel-brew">
          <pre><code><span class="prompt">$</span> brew install omar-os/omar/omar</code></pre>
          <p class="install-note">
            Automatically installs tmux as a dependency.
          </p>
        </div>
        <div class="install-panel" id="panel-source">
          <pre><code><span class="prompt">$</span> git clone https://github.com/omar-os/omar.git
<span class="prompt">$</span> cd omar && make install</code></pre>
          <p class="install-note">
            Requires Rust 1.89+, GNU Make, Node.js 22.13+, and elan.
          </p>
        </div>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Prerequisites</h3>
            <p>
              tmux 3.0+, Git, and at least one agent backend:
              <a
                href="https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
                >Claude Code</a
              >,
              <a href="https://developers.openai.com/codex/cli">Codex CLI</a>,
              <a href="https://github.com/anomalyco/opencode">Opencode</a>,
              <a href="https://cursor.com/cli">Cursor CLI</a>, or
              <a href="https://antigravity.google/product/antigravity-cli"
                >Google Antigravity CLI</a
              >.
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Launch Mission Control</h3>
            <pre><code><span class="prompt">$</span> omar up --name dev --web</code></pre>
            <p>
              Opens the web UI in your browser. Describe a workflow, confirm the
              program it drafts, and watch the run on a live diagram. Closing
              the browser leaves the session running.
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Or drive it from the terminal</h3>
            <pre><code><span class="prompt">$</span> omar attach -s dev --tui</code></pre>
            <p>
              Attach to the same session in tmux. <code>omar down -s dev</code> stops
              and keeps it; <code>omar rm -s dev</code> removes it and its state.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prompt {
    color: var(--text-dim);
    user-select: none;
  }

  /* Demo */
  .demo {
    padding: clamp(3rem, 6vw, 5rem) 0 4rem;
  }

  .demo .container {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .demo-figure {
    min-width: 0;
    margin: 0;
  }

  .demo figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  .demo video,
  .demo iframe {
    display: block;
    width: 100%;
    border: 1px solid rgba(140, 99, 242, 0.38);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  /* Its own aspect ratio, so nothing jumps while it loads. */
  .demo video,
  .demo iframe {
    height: auto;
    aspect-ratio: 1280 / 694;
  }

  /* Features */
  .features {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
    background: var(--bg-surface);
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 2.5rem;
    font-weight: 600;
    color: var(--text-bright);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(
      145deg,
      rgba(252, 247, 240, 0.035),
      rgba(140, 99, 242, 0.07)
    );
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      background 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--border-hover);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .feature-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* Quick Start */
  .quickstart {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .quickstart .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .install-methods {
    max-width: 600px;
    width: 100%;
    margin-bottom: 3rem;
    padding: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .install-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .install-tab {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    font-family: inherit;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .install-tab:hover {
    color: var(--text-bright);
  }

  .install-tab.active {
    color: var(--accent-bright);
    border-bottom-color: var(--accent);
    font-weight: 500;
  }

  .install-panel {
    display: none;
  }

  .install-panel.active {
    display: block;
  }

  .install-note {
    font-size: 0.825rem;
    color: var(--text-dim);
    margin-top: 0.75rem;
  }

  .steps {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    border: 1px solid rgba(140, 99, 242, 0.52);
    color: var(--accent-bright);
    font-weight: 600;
    border-radius: 50%;
    font-size: 0.85rem;
  }

  .step-content {
    flex: 1;
  }

  .step-content h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--text-bright);
    font-weight: 600;
  }

  .step-content p {
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .step-content pre {
    margin-top: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .demo .container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .step {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (min-width: 769px) and (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .install-methods {
      padding: 1rem;
    }

    .install-tab {
      flex: 1;
      padding-inline: 0.35rem;
    }
  }
</style>

<script>
  document.querySelectorAll(".install-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll(".install-tab")
        .forEach((t) => t.classList.remove("active"));
      document
        .querySelectorAll(".install-panel")
        .forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document
        .getElementById(`panel-${tab.dataset.tab}`)
        ?.classList.add("active");
    });
  });
</script>
