---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Lead an army of 100 agents to solve humanity's biggest problems. OMAR is a TUI for creating powerful agentic organizations."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <h1 class="hero-title">
          Lead an army of<br /><span class="hero-accent">100 agents</span><br
          />from a single terminal.
        </h1>
        <p class="hero-subtitle">
          <code>omar</code> is a TUI for creating powerful agentic organizations.
          Deep hierarchies of parallel AI agents, managed like a company.
        </p>
        <div class="hero-actions">
          <a href={`${import.meta.env.BASE_URL}docs/`} class="btn btn-primary">Get Started</a>
          <a
            href="https://github.com/lsk567/omar"
            class="btn btn-outline"
            target="_blank"
            rel="noopener">GitHub</a
          >
        </div>
      </div>
      <div class="hero-image">
        <img
          src={`${import.meta.env.BASE_URL}img/thermopylae.png`}
          alt="OMAR TUI dashboard showing agents in action"
        />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="container">
      <h2 class="section-title">Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>Deep hierarchies</h3>
          <p>
            Agents managing agents, just like a company. Create parallel
            organizations of arbitrary depth.
          </p>
        </div>
        <div class="feature-card">
          <h3>Heterogeneous backends</h3>
          <p>
            Let Claude, Codex, Cursor, and Opencode collaborate as a team. Mix
            and match the best model for each task.
          </p>
        </div>
        <div class="feature-card">
          <h3>Full control</h3>
          <p>
            Talk to and control any subagent you want. Navigate hierarchies with
            arrow keys and attach via popup.
          </p>
        </div>
        <div class="feature-card">
          <h3>Flexible lifespans</h3>
          <p>
            Long-running or ephemeral agents, your choice. Persistent state
            across sessions with memory snapshots.
          </p>
        </div>
        <div class="feature-card">
          <h3>Messaging &amp; integrations</h3>
          <p>
            Connect agents to Slack channels. Bridge the gap between human and
            AI workflows seamlessly.
          </p>
        </div>
        <div class="feature-card">
          <h3>Built on tmux</h3>
          <p>
            Supports all tmux commands and key bindings. Highly customizable
            with battle-tested session management.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="quickstart">
    <div class="container">
      <h2 class="section-title">Quick Start</h2>
      <div class="install-methods">
        <div class="install-tabs">
          <button class="install-tab active" data-tab="oneliner"
            >One-Liner</button
          >
          <button class="install-tab" data-tab="brew">Homebrew</button>
          <button class="install-tab" data-tab="source">From Source</button>
        </div>
        <div class="install-panel active" id="panel-oneliner">
          <pre><code><span class="prompt">$</span> curl -fsSL https://omarmy.ai/install.sh | sh</code></pre>
          <p class="install-note">
            Works on macOS and Linux. Installs all binaries to <code
              >/usr/local/bin</code
            >.
          </p>
        </div>
        <div class="install-panel" id="panel-brew">
          <pre><code><span class="prompt">$</span> brew install lsk567/omar/omar</code></pre>
          <p class="install-note">
            Automatically installs tmux as a dependency.
          </p>
        </div>
        <div class="install-panel" id="panel-source">
          <pre><code><span class="prompt">$</span> git clone https://github.com/lsk567/omar.git
<span class="prompt">$</span> cd omar && make install</code></pre>
          <p class="install-note">Requires Rust 1.70+ and GNU Make.</p>
        </div>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Prerequisites</h3>
            <p>
              tmux 3.0+ and at least one agent backend:
              <a
                href="https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
                >Claude Code</a
              >,
              <a href="https://developers.openai.com/codex/cli">Codex CLI</a>,
              <a href="https://github.com/anomalyco/opencode">Opencode</a>, or
              <a href="https://cursor.com/cli">Cursor CLI</a>.
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Launch</h3>
            <pre><code><span class="prompt">$</span> omar</code></pre>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Give your EA a task</h3>
            <p>
              Copy a prompt into your Executive Assistant window and watch
              agents spawn.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Agent Backends -->
  <section class="backends">
    <div class="container">
      <h2 class="section-title">Supported Backends</h2>
      <div class="backends-table">
        <table>
          <thead>
            <tr>
              <th>Backend</th>
              <th>How to launch</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td
                ><a
                  href="https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
                  >Claude Code</a
                ></td
              >
              <td><code>omar</code> or <code>omar --agent claude</code></td>
            </tr>
            <tr>
              <td
                ><a href="https://developers.openai.com/codex/cli">Codex CLI</a
                ></td
              >
              <td><code>omar --agent codex</code></td>
            </tr>
            <tr>
              <td
                ><a href="https://github.com/anomalyco/opencode">Opencode</a
                ></td
              >
              <td><code>omar --agent opencode</code></td>
            </tr>
            <tr>
              <td><a href="https://cursor.com/cli">Cursor CLI</a></td>
              <td><code>omar --agent cursor</code></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
  }

  .hero-inner {
    max-width: 1100px;
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-tag {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    line-height: 1.15;
    color: var(--text-bright);
  }

  .hero-accent {
    color: #dc143c;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text);
    margin-bottom: 2rem;
    max-width: 560px;
    line-height: 1.7;
  }

  .hero-subtitle code {
    font-weight: 600;
  }

  .hero-install {
    margin-bottom: 1.5rem;
  }

  .hero-install pre {
    display: inline-block;
  }

  .prompt {
    color: var(--text-dim);
    user-select: none;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-image {
    flex: 1;
    min-width: 0;
  }

  .hero-image img {
    max-width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    opacity: 0.9;
  }

  /* Features */
  .features {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 2.5rem;
    font-weight: 600;
    color: var(--text-bright);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }

  .feature-card:hover {
    border-color: var(--border-hover);
  }

  .feature-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* Quick Start */
  .quickstart {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .install-methods {
    max-width: 600px;
    margin-bottom: 3rem;
  }

  .install-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .install-tab {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    font-family: inherit;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .install-tab:hover {
    color: var(--text-bright);
  }

  .install-tab.active {
    color: var(--text-bright);
    border-bottom-color: var(--text-bright);
    font-weight: 500;
  }

  .install-panel {
    display: none;
  }

  .install-panel.active {
    display: block;
  }

  .install-note {
    font-size: 0.825rem;
    color: var(--text-dim);
    margin-top: 0.75rem;
  }

  .steps {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-weight: 600;
    border-radius: 50%;
    font-size: 0.85rem;
  }

  .step-content {
    flex: 1;
  }

  .step-content h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--text-bright);
    font-weight: 600;
  }

  .step-content p {
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .step-content pre {
    margin-top: 0.5rem;
  }

  /* Backends */
  .backends {
    padding: 3rem 0 4rem;
    border-top: 1px solid var(--border);
  }

  .backends-table {
    max-width: 520px;
  }

  .backends-table table {
    width: 100%;
    border-collapse: collapse;
  }

  .backends-table th,
  .backends-table td {
    padding: 0.625rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
    font-size: 0.875rem;
  }

  .backends-table th {
    background: var(--bg-surface);
    color: var(--text-bright);
    font-weight: 600;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-inner {
      flex-direction: column;
    }

    .hero-title {
      font-size: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .step {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  document.querySelectorAll(".install-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll(".install-tab")
        .forEach((t) => t.classList.remove("active"));
      document
        .querySelectorAll(".install-panel")
        .forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document
        .getElementById(`panel-${tab.dataset.tab}`)
        ?.classList.add("active");
    });
  });
</script>
