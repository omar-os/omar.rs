---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="LLM agents are unpredictable. Their coordination doesn't have to be. OMAR delivers deterministic, formally specified orchestration for multi-agent systems."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <h1 class="hero-title">
        LLM agents are unpredictable.<br />Their coordination<br /><span
          class="hero-accent">doesn't have to be.</span
        >
      </h1>
      <p class="hero-subtitle">
        <code>omar</code> delivers deterministic, formally specified orchestration
        for multi-agent systems.
      </p>
      <div class="hero-actions">
        <a href={`${import.meta.env.BASE_URL}docs/`} class="btn btn-primary"
          >Get Started</a
        >
        <a
          href="https://github.com/omar-os/omar"
          class="btn btn-outline"
          target="_blank"
          rel="noopener">GitHub</a
        >
      </div>
    </div>
  </section>

  <!-- Demo -->
  <section class="demo">
    <div class="container">
      <figure class="demo-figure">
        {
          /* Silent screen capture, so it may autoplay muted and loop the way
             the terminal cast beside it does. `playsinline` keeps iOS from
             taking it fullscreen; controls are there because it runs for three
             minutes and nobody should have to watch it from the top. */
        }
        <video
          src={`${import.meta.env.BASE_URL}video/hierarchy.mp4`}
          poster={`${import.meta.env.BASE_URL}video/hierarchy-poster.jpg`}
          width="1280"
          height="694"
          autoplay
          muted
          loop
          playsinline
          controls
          preload="metadata"></video>
        <figcaption>Mission Control</figcaption>
      </figure>
      <figure class="demo-figure">
        <iframe
          src="https://asciinema.org/a/946195/iframe?autoplay=1&loop=1&speed=2&theme=asciinema"
          allowfullscreen
          loading="lazy"
          scrolling="no"></iframe>
        <figcaption>Terminal UI</figcaption>
      </figure>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="container">
      <h2 class="section-title">Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>Deep hierarchies</h3>
          <p>
            Agents managing agents, just like a company. Create parallel
            organizations of arbitrary depth.
          </p>
        </div>
        <div class="feature-card">
          <h3>Heterogeneous backends</h3>
          <p>
            Let Claude, Codex, Cursor, and Opencode collaborate as a team. Mix
            and match the best model for each task.
          </p>
        </div>
        <div class="feature-card">
          <h3>Full control</h3>
          <p>
            Talk to and control any subagent you want. Navigate hierarchies with
            arrow keys and attach via popup.
          </p>
        </div>
        <div class="feature-card">
          <h3>Flexible lifespans</h3>
          <p>
            Long-running or ephemeral agents, your choice. Persistent state
            across sessions with memory snapshots.
          </p>
        </div>
        <div class="feature-card">
          <h3>Messaging &amp; integrations</h3>
          <p>
            Connect agents to Slack channels. Bridge the gap between human and
            AI workflows seamlessly.
          </p>
        </div>
        <div class="feature-card">
          <h3>Built on tmux</h3>
          <p>
            Supports all tmux commands and key bindings. Highly customizable
            with battle-tested session management.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="quickstart">
    <div class="container">
      <h2 class="section-title">Quick Start</h2>
      <div class="install-methods">
        <div class="install-tabs">
          <button class="install-tab active" data-tab="oneliner"
            >One-Liner</button
          >
          <button class="install-tab" data-tab="brew">Homebrew</button>
          <button class="install-tab" data-tab="source">From Source</button>
        </div>
        <div class="install-panel active" id="panel-oneliner">
          <pre><code><span class="prompt">$</span> curl -fsSL https://omar.rs/install.sh | sh</code></pre>
          <p class="install-note">
            Works on macOS and Linux. Installs all binaries to <code
              >/usr/local/bin</code
            >.
          </p>
        </div>
        <div class="install-panel" id="panel-brew">
          <pre><code><span class="prompt">$</span> brew install omar-os/omar/omar</code></pre>
          <p class="install-note">
            Automatically installs tmux as a dependency.
          </p>
        </div>
        <div class="install-panel" id="panel-source">
          <pre><code><span class="prompt">$</span> git clone https://github.com/omar-os/omar.git
<span class="prompt">$</span> cd omar && make install</code></pre>
          <p class="install-note">Requires Rust 1.70+ and GNU Make.</p>
        </div>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <div class="step-content">
            <h3>Prerequisites</h3>
            <p>
              tmux 3.0+ and at least one agent backend:
              <a
                href="https://docs.anthropic.com/en/docs/agents-and-tools/claude-code/overview"
                >Claude Code</a
              >,
              <a href="https://developers.openai.com/codex/cli">Codex CLI</a>,
              <a href="https://github.com/anomalyco/opencode">Opencode</a>, or
              <a href="https://cursor.com/cli">Cursor CLI</a>.
            </p>
          </div>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <div class="step-content">
            <h3>Launch</h3>
            <pre><code><span class="prompt">$</span> omar</code></pre>
          </div>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <div class="step-content">
            <h3>Give your EA a task</h3>
            <p>
              Copy a prompt into your Executive Assistant window and watch
              agents spawn.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: clamp(5rem, 11vw, 8rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-tag {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1rem;
    letter-spacing: 0.02em;
  }

  .hero-title {
    /* Smaller than the old headline needed: this one is two sentences,
       and at 4.6rem the first alone took two lines. */
    font-size: clamp(2rem, 4.4vw, 3.35rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    margin-bottom: 1.5rem;
    line-height: 1.06;
    color: var(--text-bright);
  }

  .hero-accent {
    color: var(--accent-bright);
    text-shadow: 0 0 38px rgba(140, 99, 242, 0.28);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: var(--text);
    margin-bottom: 2rem;
    margin-left: auto;
    margin-right: auto;
    max-width: 620px;
    line-height: 1.7;
  }

  .hero-subtitle code {
    font-weight: 600;
  }

  .hero-install {
    margin-bottom: 1.5rem;
  }

  .hero-install pre {
    display: inline-block;
  }

  .prompt {
    color: var(--text-dim);
    user-select: none;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Demo */
  .demo {
    padding: 0 0 4rem;
  }

  .demo-figure {
    margin: 0 0 2.5rem;
  }

  .demo-figure:last-child {
    margin-bottom: 0;
  }

  .demo figcaption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }

  .demo video,
  .demo iframe {
    display: block;
    width: 100%;
    border: 1px solid rgba(140, 99, 242, 0.38);
    border-radius: var(--radius);
    overflow: hidden;
    background: #000;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  /* Its own aspect ratio, so nothing jumps while it loads. */
  .demo video {
    height: auto;
    aspect-ratio: 1280 / 694;
  }

  .demo iframe {
    height: 600px;
  }

  /* Features */
  .features {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.18);
  }

  .section-title {
    font-size: 1.5rem;
    margin-bottom: 2.5rem;
    font-weight: 600;
    color: var(--text-bright);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.025),
      rgba(140, 99, 242, 0.035)
    );
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      background 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--border-hover);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .feature-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
  }

  .feature-card p {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /* Quick Start */
  .quickstart {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .quickstart .container {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .install-methods {
    max-width: 600px;
    width: 100%;
    margin-bottom: 3rem;
    padding: 1.25rem;
    background: rgba(14, 13, 19, 0.72);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .install-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  .install-tab {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    font-family: inherit;
    transition:
      color 0.15s,
      border-color 0.15s;
  }

  .install-tab:hover {
    color: var(--text-bright);
  }

  .install-tab.active {
    color: var(--accent-bright);
    border-bottom-color: var(--accent);
    font-weight: 500;
  }

  .install-panel {
    display: none;
  }

  .install-panel.active {
    display: block;
  }

  .install-note {
    font-size: 0.825rem;
    color: var(--text-dim);
    margin-top: 0.75rem;
  }

  .steps {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .step {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    border: 1px solid rgba(140, 99, 242, 0.52);
    color: var(--accent-bright);
    font-weight: 600;
    border-radius: 50%;
    font-size: 0.85rem;
  }

  .step-content {
    flex: 1;
  }

  .step-content h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
    color: var(--text-bright);
    font-weight: 600;
  }

  .step-content p {
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .step-content pre {
    margin-top: 0.5rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .demo iframe {
      height: 350px;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .step {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (min-width: 769px) and (max-width: 960px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .demo iframe {
      height: 260px;
    }

    .install-methods {
      padding: 1rem;
    }

    .install-tab {
      flex: 1;
      padding-inline: 0.35rem;
    }
  }
</style>

<script>
  document.querySelectorAll(".install-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      document
        .querySelectorAll(".install-tab")
        .forEach((t) => t.classList.remove("active"));
      document
        .querySelectorAll(".install-panel")
        .forEach((p) => p.classList.remove("active"));
      tab.classList.add("active");
      document
        .getElementById(`panel-${tab.dataset.tab}`)
        ?.classList.add("active");
    });
  });
</script>
