---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("zh-blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<BaseLayout title="博客" description="OMAR 项目的更新和文章" lang="zh-CN">
  <div class="blog-index container">
    <h1>博客</h1>
    <p class="blog-desc">OMAR 项目的更新、发布和技术文章。</p>
    <div class="posts">
      {
        posts.map((post) => (
          <a href={`/zh/blog/${post.id}/`} class="post-card">
            <time>
              {new Date(post.data.date).toLocaleDateString("zh-CN", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index {
    max-width: 42rem;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .blog-index h1 {
    font-size: 1.75rem;
    margin-bottom: 0.35rem;
  }

  .blog-desc {
    color: var(--text-dim);
    margin-bottom: 2.5rem;
    font-size: 0.95rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: block;
    padding: 1.25rem 0;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }

  .post-card:first-child {
    border-top: 1px solid var(--border);
  }

  .post-card:hover {
    background: var(--bg-surface);
    margin: 0 -1rem;
    padding: 1.25rem 1rem;
  }

  .post-card time {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .post-card h2 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-bright);
    margin: 0.2rem 0 0.35rem;
  }

  .post-card p {
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.5;
  }
</style>
