    </li>
    <li>
      <a href={`${import.meta.env.BASE_URL}docs/api-reference/`}>HTTP API Reference</a> &mdash; programmatic agent
      control
    </li>
    <li>
      <a href={`${import.meta.env.BASE_URL}docs/agent-orchestration/`}>Agent Orchestration</a> &mdash; manager-worker
      patterns
    </li>
  </ul>
</DocsLayout>
