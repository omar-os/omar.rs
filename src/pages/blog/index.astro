---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<BaseLayout
  title="Blog"
  description="Updates and articles from the OMAR project"
>
  <div class="blog-index container">
    <h1>Blog</h1>
    <p class="blog-desc">
      Updates, releases, and articles from the OMAR project.
    </p>
    <div class="posts">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="post-card">
            <time>
              {new Date(post.data.date).toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            <h2>{post.data.title}</h2>
            {post.data.description && <p>{post.data.description}</p>}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index {
    max-width: 48rem;
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .blog-index h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .blog-desc {
    color: var(--text-dim);
    margin-bottom: 2.5rem;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }

  .post-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 2px 20px rgba(201, 168, 76, 0.08);
  }

  .post-card time {
    font-size: 0.8rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
  }

  .post-card h2 {
    font-size: 1.25rem;
    color: var(--accent);
    margin: 0.25rem 0 0.5rem;
  }

  .post-card p {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.5;
  }
</style>
