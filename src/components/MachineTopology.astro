---

<machine-topology
  class="topology"
  aria-label={text(
    "Illustrative OMAR topology: a timer triggers planning, two teams work in parallel, both results gather for review, feedback triggers a revision, and publishing completes the chain.",
    "OMAR 拓扑演示：定时器触发规划，两个团队并行工作，汇聚结果进行审查，反馈触发修订，最后发布结果。",
  )}
  role="img"
  data-idle={text("idle", "空闲")}
  data-running={text("running", "运行中")}
  data-completed={text("completed", "已完成")}
>
  <svg viewBox="0 90 1285 510" aria-hidden="true">
    <defs
      ><pattern
        id="topology-grid"
        width="24"
        height="24"
        patternUnits="userSpaceOnUse"
        ><circle cx="1" cy="1" r=".7" fill="var(--accent)" opacity=".2"
        ></circle></pattern
      ></defs
    >
    <rect width="1285" height="640" fill="url(#topology-grid)"></rect>
    {
      teams.map((team) => (
        <g class="team">
          <rect
            x={team.x}
            y={team.y}
            width={team.w}
            height={team.h}
            rx="9"
            class="team-body"
          />
          <text x={team.x + 15} y={team.y + 28} class="team-name">
            {team.name}
          </text>
          <g transform={`translate(${team.x + team.w - 27} ${team.y + 23})`}>
            <circle r="15" class="backend-circle" />
            <image
              href={`${import.meta.env.BASE_URL}logos/backends/${team.icon}.svg`}
              x="-9"
              y="-9"
              width="18"
              height="18"
            >
              <title>{team.backend}</title>
            </image>
          </g>
        </g>
      ))
    }
    {
      connections.map((edge) => (
        <g data-from={edge.from} data-to={edge.to}>
          <path class:list={["connection", edge.kind]} d={edge.d} />
          <path
            class="message"
            d={edge.d}
            pathLength="100"
            data-windows={JSON.stringify(edge.windows)}
          />
        </g>
      ))
    }
    <text x="660" y="572" text-anchor="middle" class="delay-label"
      >after 250 ms</text
    >
    <text x="410" y="308" text-anchor="middle" class="route-label"
      >{text("scatter", "分发")}</text
    >
    <text x="840" y="307" text-anchor="middle" class="route-label"
      >{text("gather", "汇聚")}</text
    >
    <g class="timer" transform="translate(100 200)" data-timer>
      <circle r="17" class="timer-face"></circle><g data-hand
        ><path d="M0 0V-10" class="timer-hand"></path></g
      ><path d="M0 0H6" class="timer-hand short"></path><circle
        r="2"
        class="timer-pin"></circle>
      <text x="26" y="-9" class="shape-label">tick</text><text
        x="26"
        y="4"
        class="timer-meta">every 24 s</text
      >
    </g>
    {
      actions.map((action) => (
        <g
          class="action"
          transform={`translate(${action.x} ${action.y})`}
          data-action
          data-windows={JSON.stringify(action.windows)}
        >
          <polygon points="0,-11 11,0 0,11 -11,0" />
          <text y="26" text-anchor="middle" class="shape-label">
            {action.name}
          </text>
        </g>
      ))
    }
    {
      reactions.map((reaction) => (
        <g
          class="reaction"
          data-reaction={reaction.id}
          data-state="idle"
          transform={`translate(${reaction.x} ${reaction.y})`}
        >
          <polygon
            class="reaction-body"
            points={`0,0 ${reaction.w - 11},0 ${reaction.w},25 ${reaction.w - 11},50 0,50 11,25`}
          />
          <rect
            class="reaction-badge"
            x="17"
            y="15"
            width="20"
            height="20"
            rx="5"
          />
          <text class="reaction-index" x="27" y="29" text-anchor="middle">
            {reaction.order}
          </text>
          <text class="reaction-name" x="46" y="23">
            {reaction.label}
          </text>
          <text class="reaction-meta" x="42" y="37">
            {reaction.backend} ·{" "}
            <tspan data-status>{text("idle", "空闲")}</tspan>
          </text>
        </g>
      ))
    }
    {
      ports.map((port) => (
        <g transform={`translate(${port.x} ${port.y})`} class="port">
          <polygon points="-5,-6.5 6.5,0 -5,6.5" />
          <text
            x={port.input ? 10 : -10}
            y="-11"
            text-anchor={port.input ? "start" : "end"}
          >
            {port.name}
          </text>
        </g>
      ))
    }
  </svg>
</machine-topology>

<style>
  .topology {
    display: block;
    width: calc(100% - clamp(2rem, 8vw, 10rem));
    max-width: 1440px;
    margin-inline: auto;
    min-width: 0;
    align-self: center;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }
  .team-body {
    fill: none;
    stroke: #aa97b5;
    stroke-width: 1;
  }
  .team-name {
    fill: var(--text-bright);
    font-size: 15px;
    font-weight: 650;
  }
  .backend-circle {
    fill: var(--bg-surface-2);
    stroke: var(--border);
  }
  .connection {
    fill: none;
    stroke: #9a88a6;
    stroke-width: 1.3;
    stroke-linecap: round;
  }
  .trigger,
  .effect {
    stroke: #777080;
    stroke-dasharray: 3 3;
  }
  .message {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 6 106;
    opacity: 0;
  }
  .delay-label,
  .route-label {
    fill: var(--text-dim);
    font-size: 10px;
  }
  .reaction-body {
    fill: #e9e5ed;
    stroke: #918797;
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .reaction-badge {
    fill: #fff;
    stroke: #b3a9bb;
  }
  .reaction-index {
    fill: #55505e;
    font-size: 10.5px;
    font-weight: 700;
  }
  .reaction-name {
    fill: #241b2c;
    font-size: 12px;
    font-weight: 650;
  }
  .reaction-meta {
    fill: #6f6578;
    font-size: 7.5px;
  }
  .reaction-body,
  .reaction-badge,
  .action polygon,
  .timer-face {
    transition:
      fill 260ms,
      stroke 260ms;
  }
  [data-state="running"] .reaction-body {
    fill: #ece5ff;
    stroke: #7049d8;
    stroke-width: 1.6;
  }
  [data-state="running"] .reaction-badge {
    fill: #7049d8;
    stroke: #7049d8;
  }
  [data-state="running"] .reaction-index,
  [data-state="completed"] .reaction-index {
    fill: white;
  }
  [data-state="completed"] .reaction-body {
    fill: #e2f1e8;
    stroke: #5d9c7b;
  }
  [data-state="completed"] .reaction-badge {
    fill: #4f9271;
    stroke: #4f9271;
  }
  .port polygon {
    fill: var(--accent-bright);
    stroke: var(--accent-bright);
    stroke-linejoin: round;
  }
  .port text,
  .shape-label {
    fill: var(--text);
    font-size: 10px;
    font-weight: 600;
  }
  .action polygon,
  .timer-face {
    fill: #fff;
    stroke: #6b6173;
    stroke-width: 1.4;
  }
  .action[data-active] polygon,
  .timer[data-active] .timer-face {
    fill: #d9c8ff;
    stroke: #7049d8;
  }
  .timer-hand {
    fill: none;
    stroke: #6b6173;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .timer-pin {
    fill: #6b6173;
  }
  .timer-meta {
    fill: var(--text-dim);
    font-size: 10px;
  }
  @media (max-width: 640px) {
    .topology {
      overflow-x: auto;
    }
    svg {
      min-width: 960px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
    }
  }
</style>

<script>
  import {
    MACHINE_CYCLE_MS,
    reactionState,
    activeWindow,
    type Window,
  } from "../lib/machine-demo";
  class MachineTopology extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      const reactions = [
        ...this.querySelectorAll<SVGGElement>("[data-reaction]"),
      ];
      const tracks = [
        ...this.querySelectorAll<SVGElement>("[data-windows]"),
      ].map((element) => ({
        element,
        windows: JSON.parse(element.dataset.windows ?? "[]") as Window[],
      }));
      const timer = this.querySelector<SVGGElement>("[data-timer]");
      const hand = this.querySelector<SVGGElement>("[data-hand]");
      const paint = (time: number, still = false) => {
        reactions.forEach((reaction) => {
          const state = reactionState(reaction.dataset.reaction ?? "", time);
          if (reaction.dataset.state !== state) {
            reaction.dataset.state = state;
            const status = reaction.querySelector("[data-status]");
            if (status) status.textContent = this.dataset[state] ?? state;
          }
        });
        tracks.forEach(({ element, windows }) => {
          const progress = still ? null : activeWindow(windows, time);
          if (element.hasAttribute("data-action"))
            element.toggleAttribute("data-active", progress !== null);
          else {
            element.style.opacity = progress === null ? "0" : "1";
            element.style.strokeDashoffset = String(6 - (progress ?? 0) * 112);
          }
        });
        timer?.toggleAttribute("data-active", !still && time < 800);
        hand?.setAttribute(
          "transform",
          `rotate(${!still && time < 800 ? (time / 800) * 360 : 0})`,
        );
      };
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      let visible = true,
        frame = 0,
        previous = 0,
        elapsed = 0;
      const render = (now: number) => {
        elapsed += previous ? Math.min(now - previous, 100) : 0;
        previous = now;
        paint(elapsed % MACHINE_CYCLE_MS);
        frame = requestAnimationFrame(render);
      };
      const sync = () => {
        cancelAnimationFrame(frame);
        previous = 0;
        if (motion.matches) paint(22000, true);
        else if (
          visible &&
          !document.hidden &&
          this.dataset.playbackActive !== "false" &&
          this.dataset.playbackPaused !== "true"
        )
          frame = requestAnimationFrame(render);
      };
      const playback = (event: Event) => {
        if ((event as CustomEvent).detail?.reset) {
          elapsed = 0;
          paint(0);
        }
        sync();
      };
      this.addEventListener("topology-playback", playback);
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      });
      observer.observe(this);
      motion.addEventListener("change", sync);
      document.addEventListener("visibilitychange", sync);
      sync();
      this.cleanup = () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        this.removeEventListener("topology-playback", playback);
        motion.removeEventListener("change", sync);
        document.removeEventListener("visibilitychange", sync);
      };
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("machine-topology"))
    customElements.define("machine-topology", MachineTopology);
</script>
