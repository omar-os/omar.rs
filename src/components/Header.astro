---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const isZh = lang.startsWith("zh");
const pathname = Astro.url.pathname;

const navItems = isZh
  ? [
      { href: "/zh/", label: "首页" },
      { href: "/zh/docs/", label: "文档" },
      { href: "/zh/blog/", label: "博客" },
    ]
  : [
      { href: "/", label: "Home" },
      { href: "/docs/", label: "Docs" },
      { href: "/blog/", label: "Blog" },
    ];

function getLangSwitchUrl() {
  if (isZh) {
    return pathname.replace(/^\/zh/, "") || "/";
  } else {
    return `/zh${pathname}`;
  }
}
---

<header class="header">
  <div class="container header-inner">
    <a href={isZh ? "/zh/" : "/"} class="logo">
      OMAR<span class="brand-suffix" id="brand-typewriter"></span>
    </a>
    <nav class="nav">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link",
              {
                active:
                  pathname === item.href ||
                  (item.href !== "/" &&
                    item.href !== "/zh/" &&
                    pathname.startsWith(item.href)),
              },
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="https://discord.gg/X76PSzmfWr"
        class="nav-link nav-icon"
        target="_blank"
        rel="noopener"
        aria-label="Discord"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
          ></path></svg
        >
      </a>
      <a
        href="https://github.com/lsk567/omar"
        class="nav-link nav-icon"
        target="_blank"
        rel="noopener"
        aria-label="GitHub"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path></svg
        >
      </a>
      <a href={getLangSwitchUrl()} class="nav-link lang-switch">
        <span class="lang-full">{isZh ? "EN" : "中文"}</span>
        <span class="lang-short">{isZh ? "EN" : "中"}</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.5rem;
  }

  .logo {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-bright);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--text-bright);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--text-dim);
    transition: color 0.15s;
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text-bright);
  }

  .nav-icon {
    display: flex;
    align-items: center;
  }

  .nav-icon svg {
    display: block;
  }

  .lang-switch {
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .lang-switch:hover {
    border-color: var(--text-dim);
  }

  .brand-suffix {
    font-weight: 400;
    color: var(--text-bright, #000);
  }

  .lang-short {
    display: none;
  }

  @media (max-width: 640px) {
    .nav {
      gap: 1rem;
    }
    .nav-link {
      font-size: 0.8rem;
    }
    .brand-suffix {
      display: none;
    }
    .lang-full {
      display: none;
    }
    .lang-short {
      display: inline;
    }
  }
</style>

<script>
  (() => {
    const el = document.getElementById("brand-typewriter");
    if (!el) return;
    if (window.matchMedia("(max-width: 640px)").matches) return;

    const text = ": open multi-agent runtime";
    const typeSpeed = 60;
    const deleteSpeed = 40;
    const pauseAfterType = 10000;
    const pauseAfterDelete = 800;
    let i = 0;

    function typeForward() {
      i++;
      el.textContent = text.slice(0, i);
      if (i < text.length) {
        setTimeout(typeForward, typeSpeed);
      } else {
        setTimeout(deleteBackward, pauseAfterType);
      }
    }

    function deleteBackward() {
      i--;
      el.textContent = text.slice(0, i);
      if (i > 0) {
        setTimeout(deleteBackward, deleteSpeed);
      } else {
        setTimeout(typeForward, pauseAfterDelete);
      }
    }

    setTimeout(typeForward, 1000);
  })();
</script>
