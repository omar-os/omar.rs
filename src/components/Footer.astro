---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;
const isZh = lang.startsWith("zh");
const prefix = isZh ? "/zh" : "";
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-brand">one-man army</span>
      <span class="footer-copy">BSD 2-Clause License</span>
    </div>
    <div class="footer-links">
      <a href="https://github.com/lsk567/omar" target="_blank" rel="noopener"
        >GitHub</a
      >
      <a href="https://discord.gg/X76PSzmfWr" target="_blank" rel="noopener"
        >Discord</a
      >
      <a href={`${prefix}/docs/`}>{isZh ? "文档" : "Docs"}</a>
      <a href={`${prefix}/blog/`}>{isZh ? "博客" : "Blog"}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-brand {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
  }

  .footer-copy {
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--text-dim);
    font-size: 0.85rem;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-brand {
    letter-spacing: 0.08em;
  }
</style>
