---
interface Props {
  lang?: "en" | "zh";
}
const { lang = "en" } = Astro.props;
const zh = lang === "zh";
const copy = zh
  ? {
      no: "拒绝智能体「蜂群」。",
      deploy: "部署",
      deterministic: "确定性、可验证的",
      machinePrefix: "智能体",
      machineWord: "机器",
      machinePeriod: "。",
      description: "为多智能体系统提供确定性的、有形式化规约的编排。",
      start: "快速开始",
      swarmWarning: "智能体蜂群不可预测且危险。请查看",
      incident: "OpenAI / Hugging Face 事件",
      machine: "智能体机器是确定性的、可验证的。",
      input: "输入",
      plan: "规划",
      execute: "执行",
      verify: "验证",
      done: "完成",
      alt: "左侧 Anthropic、OpenAI、Cursor、OpenCode 和 Antigravity 智能体沿杂乱路径漂移；右侧工作流依次经过输入、规划、执行、验证和完成。",
    }
  : {
      no: "Say no to agent “swarms”.",
      deploy: "Deploy",
      deterministic: "deterministic, verifiable",
      machinePrefix: "agentic ",
      machineWord: "machines",
      machinePeriod: ".",
      description:
        "delivers deterministic, formally specified orchestration for multi-agent systems.",
      start: "Get Started",
      swarmWarning: "Agent swarm is unpredictable and dangerous. Check the",
      incident: "OpenAI / Hugging Face incident",
      machine: "An agentic machine is deterministic and verifiable.",
      input: "INPUT",
      plan: "PLAN",
      execute: "EXECUTE",
      verify: "VERIFY",
      done: "DONE",
      alt: "Anthropic, OpenAI, Cursor, OpenCode, and Antigravity agents drift along tangled paths on the left. On the right, an ordered workflow moves through input, plan, execute, verify, and done.",
    };
const backends = [
  { name: "Anthropic", icon: "anthropic" },
  { name: "OpenAI", icon: "openai" },
  { name: "Cursor", icon: "cursor" },
  { name: "OpenCode", icon: "opencode" },
  { name: "Antigravity (Google)", icon: "google" },
];
const points = [
  [42, 105],
  [133, 63],
  [237, 102],
  [82, 197],
  [192, 173],
  [279, 231],
  [39, 295],
  [145, 320],
  [258, 346],
  [307, 146],
  [188, 265],
  [93, 382],
];
const states = [
  { x: 440, y: 224, label: copy.input },
  { x: 557, y: 224, label: copy.plan },
  { x: 674, y: 224, label: copy.execute },
  { x: 791, y: 224, label: copy.verify },
  { x: 908, y: 224, label: copy.done },
];
---

<section class="machine-hero">
  <div class="container">
    <div class="hero-copy">
      <h1>
        <span>{copy.no}</span><span
          >{copy.deploy} <em>{copy.deterministic}</em></span
        ><span
          >{copy.machinePrefix}<span class="machine-word"
            >{copy.machineWord}</span
          >{copy.machinePeriod}</span
        >
      </h1>
      <div class="description">
        <p><code>omar</code> {copy.description}</p>
      </div>
      <div class="actions">
        <a
          class="btn btn-primary"
          href={`${import.meta.env.BASE_URL}${zh ? "zh/" : ""}docs/`}
          >{copy.start}<span aria-hidden="true">↗</span></a
        >
        <a
          class="btn btn-outline"
          href="https://github.com/omar-os/omar"
          target="_blank"
          rel="noopener">GitHub <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </div>
  <agent-diagram class="diagram-wrap" role="group" aria-label={copy.alt}>
    <div class="diagram-labels">
      <div>
        <p class="swarm-warning">
          {copy.swarmWarning}
          <a
            href="https://metr.org/blog/2026-08-26-openai-hugging-face-incident-investigation/#agents-were-very-interested-in-manipulating-their-own-transcripts,-and-their-tests-successfully-“spoofed”-some-tool-calls-in-our-transcripts"
            >{copy.incident}</a
          >.
        </p>
      </div><div>
        <p class="machine-label">{copy.machine}</p>
      </div>
    </div>
    <svg
      class="diagram swarm-diagram"
      viewBox="0 30 360 400"
      aria-hidden="true"
    >
      <defs>
        <pattern
          id="machine-grid"
          width="24"
          height="24"
          patternUnits="userSpaceOnUse"
          ><circle cx="1" cy="1" r=".7" fill="var(--accent)" opacity=".22"
          ></circle></pattern
        >
        <linearGradient id="machine-line"
          ><stop stop-color="var(--accent)"></stop><stop
            offset="1"
            stop-color="var(--success)"></stop></linearGradient
        >
        <radialGradient id="machine-glow"
          ><stop stop-color="var(--accent)" stop-opacity=".18"></stop><stop
            offset="1"
            stop-color="var(--accent)"
            stop-opacity="0"></stop></radialGradient
        >
      </defs>
      <rect width="1000" height="430" fill="url(#machine-grid)"></rect>
      <ellipse cx="700" cy="220" rx="310" ry="200" fill="url(#machine-glow)"
      ></ellipse>
      <g class="swarm" fill="none" stroke="var(--coral)">
        <g class="swarm-links">
          {
            points.map(([x, y], i) => {
              const [endX, endY] = points[(i + 3) % points.length];
              return (
                <path
                  class="swarm-link"
                  d={`M${x} ${y} Q${(x + endX) / 2 + 35} ${(y + endY) / 2 - 35} ${endX} ${endY}`}
                />
              );
            })
          }
        </g>
        {
          points.map(([x, y], i) => (
            <g class="wander" data-x={x} data-y={y}>
              <>
                <circle
                  cx={x}
                  cy={y}
                  r="19"
                  fill="var(--coral-soft)"
                  stroke-opacity=".6"
                />
                <image
                  href={`${import.meta.env.BASE_URL}logos/backends/${backends[i % backends.length].icon}.svg`}
                  x={x - 11}
                  y={y - 11}
                  width="22"
                  height="22"
                >
                  <title>{backends[i % backends.length].name}</title>
                </image>
              </>
            </g>
          ))
        }
      </g>
    </svg>
    <svg
      class="diagram machine-diagram"
      viewBox="390 40 570 370"
      aria-hidden="true"
    >
      <rect x="390" width="610" height="430" fill="url(#machine-grid)"></rect>
      <ellipse cx="700" cy="220" rx="310" ry="200" fill="url(#machine-glow)"
      ></ellipse>
      <path class="rail" d="M440 224H908"></path>
      <path class="return-rail" d="M791 246V319H557V246"></path>
      <text x="674" y="344" class="svg-note" text-anchor="middle"
        >{zh ? "有界重试" : "BOUNDED RETRY"}</text
      >
      <path class="signal" d="M440 224H908"></path>
      {
        states.map(({ x, y, label }, i) => (
          <g
            class:list={["state", { "final-state": i === 4 }]}
            style={`--step:${i}`}
          >
            <rect
              class="node-halo"
              x={x - 31}
              y={y - 31}
              width="62"
              height="62"
              rx="19"
            />
            <rect
              class="node"
              x={x - 23}
              y={y - 23}
              width="46"
              height="46"
              rx="12"
            />
            {i === 4 ? (
              <path class="node-icon" d={`m${x - 7} ${y} 5 5 10-10`} />
            ) : i === 3 ? (
              <path
                class="node-icon"
                d={`M${x} ${y - 10}l9 4v7l-9 7-9-7v-7z`}
              />
            ) : (
              <>
                <circle cx={x - 6} cy={y} r="2" fill="currentColor" />
                <circle cx={x + 6} cy={y} r="2" fill="currentColor" />
                <path d={`M${x - 4} ${y}h8`} stroke="currentColor" />
              </>
            )}
            <text x={x} y={y - 48} text-anchor="middle" class="state-number">
              0{i + 1}
            </text>
            <text x={x} y={y + 53} text-anchor="middle" class="state-label">
              {label}
            </text>
          </g>
        ))
      }
      <g class="verified"
        ><rect
          x="731"
          y="92"
          width="190"
          height="31"
          rx="15"
          fill="var(--success-surface)"
          stroke="var(--success-border)"></rect><circle
          cx="749"
          cy="107"
          r="3"
          fill="var(--success)"></circle><text
          x="764"
          y="111"
          class="verified-label"
          >{zh ? "转换条件已检查" : "TRANSITION CHECKED"}</text
        ></g
      >
    </svg>
  </agent-diagram>
</section>

<style>
  .machine-hero {
    padding: 5rem 0 4rem;
    overflow: hidden;
  }
  .hero-copy {
    text-align: center;
    max-width: 960px;
    margin: 0 auto 3rem;
  }
  h1 {
    font-size: clamp(2rem, 4.7vw, 3.6rem);
    line-height: 1.13;
    letter-spacing: -0.045em;
    font-weight: 600;
  }
  h1 > span {
    display: block;
  }
  .machine-word {
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 0.055em;
  }
  h1 em {
    font-style: normal;
    color: var(--accent-bright);
    background: linear-gradient(110deg, #dac5ff, #a77bfa 65%, #d8c1ff);
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .description {
    max-width: 620px;
    margin: 1.5rem auto 1.8rem;
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.8;
  }
  .actions {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
  }
  .actions a {
    gap: 1.6rem;
  }
  .diagram-wrap {
    position: relative;
    display: grid;
    grid-template-columns: 36% 64%;
  }
  .diagram-wrap::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 36%;
    width: 1px;
    background: var(--border);
    pointer-events: none;
  }
  .diagram-labels {
    display: contents;
  }
  .diagram-labels > div {
    padding: 1.5rem 1.5rem 0;
    grid-row: 1;
  }
  .swarm-diagram {
    grid-column: 1;
    grid-row: 2;
  }
  .machine-diagram {
    grid-column: 2;
    grid-row: 2;
  }
  .diagram-labels p {
    font-size: 13px;
    line-height: 1.7;
    margin-top: 0;
  }
  .swarm-warning {
    color: var(--coral);
  }
  .machine-label {
    color: var(--accent-bright);
  }
  .swarm-warning a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .diagram {
    display: block;
    width: 100%;
    height: auto;
  }
  .swarm-link {
    stroke-dasharray: 4 7;
    stroke-width: 1.1;
    opacity: 0.4;
    fill: none;
    stroke-linecap: round;
  }
  .rail {
    fill: none;
    stroke: url(#machine-line);
    stroke-width: 2;
    opacity: 0.5;
  }
  .return-rail {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
    stroke-dasharray: 4 5;
    opacity: 0.4;
  }
  .signal {
    fill: none;
    stroke: var(--accent-bright);
    stroke-width: 3;
    stroke-dasharray: 24 480;
    animation: signal 8s linear infinite;
    filter: drop-shadow(0 0 5px var(--accent-bright));
  }
  .state {
    color: var(--accent-bright);
  }
  .node {
    fill: var(--bg-surface-2);
    stroke: var(--accent);
    stroke-width: 1.3;
    animation: node 8s infinite;
    animation-delay: calc(var(--step) * 1.65s);
  }
  .node-halo {
    fill: rgba(140, 99, 242, 0.04);
    stroke: rgba(140, 99, 242, 0.2);
  }
  .node-icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .final-state {
    color: var(--success);
  }
  .state-label {
    fill: var(--text);
    font: 10px var(--font-mono);
    letter-spacing: 1px;
  }
  .state-number,
  .svg-note {
    fill: var(--text-dim);
    font: 9px var(--font-mono);
    letter-spacing: 1px;
  }
  .verified {
    animation: verified 8s infinite;
  }
  .verified-label {
    fill: var(--success);
    font: 9px var(--font-mono);
    letter-spacing: 0.5px;
  }
  @keyframes signal {
    from {
      stroke-dashoffset: 24;
    }
    to {
      stroke-dashoffset: -480;
    }
  }
  @keyframes node {
    0%,
    24%,
    100% {
      fill: var(--bg-surface-2);
      stroke: var(--accent);
    }
    7%,
    17% {
      fill: #62418c;
      stroke: var(--accent-bright);
    }
  }
  @keyframes verified {
    0%,
    55%,
    100% {
      opacity: 0.35;
    }
    65%,
    90% {
      opacity: 1;
    }
  }
  @media (max-width: 640px) {
    .machine-hero {
      padding: 3rem 0;
    }
    h1 {
      font-size: clamp(1.85rem, 6.5vw, 2.7rem);
    }
    h1 em {
      display: block;
    }
    .description {
      font-size: 0.9rem;
    }
    .hero-copy {
      margin-bottom: 2rem;
    }
    .diagram-wrap {
      grid-template-columns: 1fr;
    }
    .diagram-wrap::after {
      display: none;
    }
    .diagram-labels > div {
      padding: 1rem 1rem 0;
    }
    .diagram-labels > div:last-child {
      border-top: 1px solid var(--border);
      grid-row: 3;
    }
    .swarm-diagram {
      height: 260px;
    }
    .machine-diagram {
      grid-column: 1;
      grid-row: 4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .diagram-wrap * {
      animation: none !important;
    }
    .signal {
      display: none;
    }
    .verified {
      opacity: 1;
    }
  }
</style>

<script>
  class AgentDiagram extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      const nodes = Array.from(this.querySelectorAll<SVGGElement>(".wander"));
      const paths = Array.from(
        this.querySelectorAll<SVGPathElement>(".swarm-link"),
      );
      const origins = nodes.map((node) => ({
        x: Number(node.dataset.x),
        y: Number(node.dataset.y),
      }));
      const initialPaths = paths.map((path) => path.getAttribute("d") ?? "");
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      let visible = true;
      let frame = 0;
      let previous = 0;
      let elapsed = 0;
      const edges = paths.map((_, i) => ({
        from: i,
        to: (i + 3) % nodes.length,
        bend: (i % 2 ? 1 : -1) * (25 + Math.random() * 55),
        direction: i % 2 ? 1 : -1,
        speed: 18 + Math.random() * 14,
        born: -Math.random() * 2000,
        duration: 2400 + Math.random() * 3000,
      }));
      const reconnect = (edge: (typeof edges)[number]) => {
        // Pick an unused pair; each edge independently fades out and reconnects.
        const candidates: [number, number][] = [];
        for (let a = 0; a < nodes.length; a++) {
          for (let b = a + 1; b < nodes.length; b++) {
            if (
              !edges.some(
                (other) =>
                  (other.from === a && other.to === b) ||
                  (other.from === b && other.to === a),
              )
            )
              candidates.push([a, b]);
          }
        }
        const pair = candidates[Math.floor(Math.random() * candidates.length)];
        if (pair) [edge.from, edge.to] = pair;
        edge.direction = Math.random() < 0.5 ? -1 : 1;
        edge.speed = 18 + Math.random() * 14;
        edge.born = elapsed;
        edge.duration = 2400 + Math.random() * 3000;
        edge.bend = (Math.random() < 0.5 ? -1 : 1) * (25 + Math.random() * 55);
      };
      const render = (timestamp: number) => {
        elapsed += previous ? Math.min(timestamp - previous, 100) : 0;
        previous = timestamp;
        const positions = origins.map((origin, i) => {
          const dx = Math.sin(elapsed / (1700 + i * 65) + i * 1.7) * 13;
          const dy = Math.cos(elapsed / (2100 + i * 45) + i * 2.1) * 15;
          nodes[i].setAttribute("transform", `translate(${dx} ${dy})`);
          return { x: origin.x + dx, y: origin.y + dy };
        });
        edges.forEach((edge, i) => {
          if (elapsed - edge.born >= edge.duration) reconnect(edge);
          const progress = (elapsed - edge.born) / edge.duration;
          const opacity =
            Math.min(1, progress / 0.2, (1 - progress) / 0.2) * 0.55;
          const a = positions[edge.from],
            b = positions[edge.to];
          const distance = Math.hypot(b.x - a.x, b.y - a.y) || 1;
          const cx = (a.x + b.x) / 2 - ((b.y - a.y) / distance) * edge.bend;
          const cy = (a.y + b.y) / 2 + ((b.x - a.x) / distance) * edge.bend;
          paths[i].setAttribute(
            "d",
            `M${a.x} ${a.y} Q${cx} ${cy} ${b.x} ${b.y}`,
          );
          paths[i].style.opacity = String(Math.max(0, opacity));
          paths[i].style.strokeDashoffset = String(
            -edge.direction * ((elapsed - edge.born) / 1000) * edge.speed,
          );
        });
        frame = requestAnimationFrame(render);
      };
      const sync = () => {
        cancelAnimationFrame(frame);
        previous = 0;
        if (motion.matches) {
          nodes.forEach((node) => node.removeAttribute("transform"));
          paths.forEach((path, i) => {
            path.setAttribute("d", initialPaths[i]);
            path.style.removeProperty("opacity");
            path.style.removeProperty("stroke-dashoffset");
          });
        } else if (visible && !document.hidden) {
          frame = requestAnimationFrame(render);
        }
      };
      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        sync();
      });
      observer.observe(this);
      motion.addEventListener("change", sync);
      document.addEventListener("visibilitychange", sync);
      sync();
      this.cleanup = () => {
        cancelAnimationFrame(frame);
        observer.disconnect();
        motion.removeEventListener("change", sync);
        document.removeEventListener("visibilitychange", sync);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get("agent-diagram"))
    customElements.define("agent-diagram", AgentDiagram);
</script>
